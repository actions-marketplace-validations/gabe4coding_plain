# Copy to .env — one of the two keys is enough. TYPESAFE_API_KEY wins when both are set.
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
# Optional: force a backend
# JEV_PROVIDER=typesafe|gateway
# Optional: mobile Appium server (also configurable with --server)
# PLAINWRIGHT_APPIUM_URL=http://127.0.0.1:4723
