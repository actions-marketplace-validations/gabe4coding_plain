{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "plainwright": {
      "type": "stdio",
      "command": "node",
      "args": [
        "bin/npx.mjs",
        "-y",
        "--package=plainwright@1.0.0",
        "plainwright",
        "--headless",
        "mcp"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
