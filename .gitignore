node_modules/
# Build output: compiled by npm run build, published to npm, never committed.
dist/
# Written by scripts/pack.mjs during npm pack/publish only.
npm-shrinkwrap.json
*.tgz
.DS_Store
.env

# Eval flows (scripts/eval-browser-steps.mjs): state, expected statuses, results and reports stay local.
.claude/hillclimb/
plainwright-results/
.plainwright/

# Explainer video project (manim scenes, narration, renders): local only.
.claude/explainer-video/

# Mod type declarations and the tsconfig.json pointing at them, written when Claude Code loads a mod with --plugin-dir.
mods/*/.claude-plugin/types/
mods/*/tsconfig.json
plugins/*/.claude-plugin/types/
plugins/*/tsconfig.json

# Design specs and implementation plans written while developing a change: local working notes, not part of the repo.
docs/superpowers/
